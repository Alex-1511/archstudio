{
  "$comment": "ArchStudio API v1 response contract. Python tests validate live responses against it; the TypeScript client's runtime guards implement the same shapes.",
  "$defs": {
    "Point": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "Opening": {"type": "object", "additionalProperties": false,
      "required": ["id", "kind", "offset", "width", "height", "sill"],
      "properties": {"id": {"type": "string"}, "kind": {"enum": ["door", "window"]}, "offset": {"type": "number"},
                     "width": {"type": "number"}, "height": {"type": "number"}, "sill": {"type": "number"}}},
    "Wall": {"type": "object", "additionalProperties": false,
      "required": ["id", "level_id", "start", "end", "thickness", "height", "material", "properties", "openings"],
      "properties": {"id": {"type": "string"}, "level_id": {"type": "string"}, "start": {"$ref": "#/$defs/Point"},
                     "end": {"$ref": "#/$defs/Point"}, "thickness": {"type": "number"}, "height": {"type": "number"},
                     "material": {"type": "string"}, "properties": {"type": "object"},
                     "openings": {"type": "array", "items": {"$ref": "#/$defs/Opening"}}}},
    "Level": {"type": "object", "additionalProperties": false, "required": ["id", "name", "elevation", "height"],
      "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "elevation": {"type": "number"}, "height": {"type": "number"}}},
    "Room": {"type": "object", "additionalProperties": false, "required": ["id", "name", "level_id", "boundary", "target_area"],
      "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "level_id": {"type": "string"},
                     "boundary": {"type": "array", "items": {"$ref": "#/$defs/Point"}, "minItems": 3},
                     "target_area": {"type": ["number", "null"]}}},
    "Project": {"type": "object", "additionalProperties": false, "required": ["name", "units", "levels", "walls", "rooms"],
      "properties": {"name": {"type": "string"}, "units": {"enum": ["m", "cm", "mm", "ft", "in"]},
                     "levels": {"type": "array", "items": {"$ref": "#/$defs/Level"}},
                     "walls": {"type": "array", "items": {"$ref": "#/$defs/Wall"}},
                     "rooms": {"type": "array", "items": {"$ref": "#/$defs/Room"}}}},
    "State": {"type": "object", "required": ["ok", "revision", "project"],
      "properties": {"ok": {"enum": [true]}, "revision": {"type": "integer"}, "project": {"$ref": "#/$defs/Project"},
                     "label": {"type": ["string", "null"]}, "result": {"type": "object"}}},
    "MeshElement": {"type": "object", "required": ["id", "type", "level_id", "positions", "indices"],
      "properties": {"id": {"type": "string"}, "type": {"enum": ["wall", "opening"]}, "level_id": {"type": "string"},
                     "wall_id": {"type": "string"}, "kind": {"enum": ["door", "window"]},
                     "positions": {"type": "array", "items": {"type": "number"}},
                     "indices": {"type": "array", "items": {"type": "integer"}}}},
    "Mesh": {"type": "object", "required": ["ok", "revision", "units", "elements"],
      "properties": {"ok": {"enum": [true]}, "revision": {"type": "integer"}, "units": {"type": "string"},
                     "elements": {"type": "array", "items": {"$ref": "#/$defs/MeshElement"}}}},
    "Tools": {"type": "object", "required": ["ok", "tools"],
      "properties": {"ok": {"enum": [true]}, "tools": {"type": "array", "items": {"type": "object",
        "required": ["name", "write", "required", "optional"],
        "properties": {"name": {"type": "string"}, "write": {"type": "boolean"},
                       "required": {"type": "array", "items": {"type": "string"}},
                       "optional": {"type": "array", "items": {"type": "string"}}}}}}},
    "Error": {"type": "object", "additionalProperties": false, "required": ["ok", "error"],
      "properties": {"ok": {"enum": [false]}, "error": {"type": "object", "additionalProperties": false,
        "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}}}
  }
}
